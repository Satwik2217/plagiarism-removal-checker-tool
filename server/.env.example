# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# LLM Provider: openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo

# OpenAI API Key
OPENAI_API_KEY=

# Anthropic API Key
ANTHROPIC_API_KEY=

# Ollama (local LLM) Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2